{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findy-hackathon-app",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GroupAgent",
        "class_name": "GroupAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroupAgent"]
    }
  ]
}
