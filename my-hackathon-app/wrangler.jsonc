{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Fixed public URL (まを's account): https://findy-campus-hackathon-2.trco0430.workers.dev
  // Do NOT rename — workers.dev subdomain is derived from this `name`.
  // Do NOT deploy from another Cloudflare account (would create a different *.workers.dev URL).
  "name": "findy-campus-hackathon-2",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GroupAgent",
        "class_name": "GroupAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroupAgent"]
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
